__pycache__/
*.pyc
.ipynb_checkpoints/

# macOS
.DS_Store

# Quarto build artefacts (freeze cache, live API cache).
# lecture/_book/ is intentionally NOT ignored: the GitLab Pages job in
# .gitlab-ci.yml publishes lecture/_book/ on the default branch, so the
# locally rendered HTML must be committed for students to access it
# without compilation.
lecture/_freeze/
lecture/_cache/
lecture/.quarto/

# Standalone sibling repo (GitHub: bartzbeielstein/challenge-leaderboard),
# only cloned locally into the working directory. Does not belong in the
# course GitLab repo.
challenge-leaderboard/
lecture/.claude/scheduled_tasks.lock
lecture/01_audit_log.html
lecture/index.html
lecture/site_libs/quarto-html/quarto-syntax-highlighting-845c23b38eaddc0f92fda52bfe77a8c8.css

